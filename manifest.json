{
  "manifest_version": 3,
  "name": "LBC Tools",
  "version": "1.0.0",
  "description": "Price changes and simple relisting tools for Leboncoin.",
  "host_permissions": ["https://*.leboncoin.fr/*", "https://api.leboncoin.fr/*"],
  "content_scripts": [{
    "matches": ["https://*.leboncoin.fr/*"],
    "js": [
      "src/core.js",
      "src/ad-service.js",
      "src/price-ui.js",
      "src/relist.js",
      "src/app.js"
    ],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
